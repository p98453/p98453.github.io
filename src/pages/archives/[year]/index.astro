---
import Base from '../../../layouts/Base.astro';
import Listing from '../../../components/Listing.astro';
import { getMonths, getYears } from '../../../lib/posts.js';

export function getStaticPaths() {
  return getYears().map(({ year }) => ({ params: { year } }));
}

const { year } = Astro.params;
const months = getMonths(year);
const posts = months.flatMap((month) => month.posts);
---

<Base title={`${year} 年`} description={`${year} 年的文章归档。`}>
  <h1 class="page-title">{year}</h1>
  <p class="subnav">
    <a href="/archives/">归档</a>
    {
      months.map((month) => (
        <>
          {' · '}
          <a href={`/archives/${year}/${month.month}/`}>
            {Number(month.month)} 月
          </a>
        </>
      ))
    }
  </p>
  <Listing posts={posts} page={1} base={`/archives/${year}/`} />
</Base>
