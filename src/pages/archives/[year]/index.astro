---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getMonths, getYears } from '../../../lib/posts.js';

export function getStaticPaths() {
  return getYears().map(({ year }) => ({ params: { year } }));
}

const { year } = Astro.params;
const months = getMonths(year);
const posts = months.flatMap((month) => month.posts);
---

<Base title={`${year} 年`} description={`${year} 年的文章归档。`}>
  <div class="shell page-intro">
    <p class="eyebrow"><a href="/archives/">归档</a></p>
    <h1 class="page-title">{year}</h1>
    <div class="chips" style="margin-top:1rem">
      {
        months.map((month) => (
          <a class="chip" href={`/archives/${year}/${month.month}/`}>
            {month.month} 月 · {month.posts.length}
          </a>
        ))
      }
    </div>
    <PostList posts={posts} />
  </div>
</Base>
