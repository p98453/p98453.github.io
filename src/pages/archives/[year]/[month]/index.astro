---
import Base from '../../../../layouts/Base.astro';
import Listing from '../../../../components/Listing.astro';
import { getYears, getMonths } from '../../../../lib/posts.js';

export function getStaticPaths() {
  return getYears().flatMap(({ year }) =>
    getMonths(year).map(({ month }) => ({
      params: { year, month },
    })),
  );
}

const { year, month } = Astro.params;
const posts = getMonths(year).find((item) => item.month === month)?.posts ?? [];
---

<Base title={`${year} 年 ${Number(month)} 月`} description={`${year} 年 ${Number(month)} 月的文章。`}>
  <h1 class="page-title">{year} 年 {Number(month)} 月</h1>
  <p class="subnav">
    <a href="/archives/">归档</a>
    {' · '}
    <a href={`/archives/${year}/`}>{year}</a>
  </p>
  <Listing posts={posts} page={1} base={`/archives/${year}/${month}/`} />
</Base>
