---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import Redirect from '../../components/Redirect.astro';
import { getPosts } from '../../lib/posts.js';
import { pageEntries } from '../../lib/paging.js';
import { site } from '../../lib/site.js';

export function getStaticPaths() {
  const posts = getPosts();
  return pageEntries(posts.length, 7).map(({ page, redirect }) => ({
    params: { page: String(page) },
    props: { page, redirect },
  }));
}

const { page, redirect } = Astro.props;
const posts = getPosts();
---

{
  redirect ? (
    <Redirect to="/" />
  ) : (
    <Base title={`第 ${page} 页`} description={site.description}>
      <Listing posts={posts} page={page} base="/" search />
    </Base>
  )
}
