---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import { getCategories, getCategory } from '../../lib/posts.js';

export function getStaticPaths() {
  return getCategories().map((category) => ({
    params: { category: category.key },
    props: { key: category.key },
  }));
}

const category = getCategory(Astro.props.key);
---

<Base title={category.label} description={`${category.label} 分类下的文章。`}>
  <h1 class="page-title">{category.label}</h1>
  <p class="subnav">
    <a href="/categories/">分类</a>
    <span> · {category.posts.length} 篇</span>
  </p>
  <Listing posts={category.posts} page={1} base={`/categories/${category.key}/`} />
</Base>
