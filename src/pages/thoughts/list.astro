---
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site.js';
---

<Base quiet noindex documentTitle={`个人随想 · ${site.title}`} description="仅对获准进入的人可见。">
  <div class="thoughts-home" data-thoughts="list" data-api={site.thoughtsApi}>
    <header class="thoughts-bar">
      <a class="seal" href="/" aria-label={site.title}>林</a>
      <div>
        <h1>个人随想 <span>已解锁</span></h1>
        <nav aria-label="随想">
          <a href="/">首页</a>
          <a href="/blog/">技术博客</a>
          <button type="button" id="lock">上锁</button>
        </nav>
      </div>
    </header>
    <p class="form-status" role="status">正在确认入口…</p>
    <div id="thought-list"></div>
    <p class="thought-count"></p>
  </div>
</Base>

<script>
  import { bootList } from '../../scripts/thoughts-client.js';
  bootList();
</script>
