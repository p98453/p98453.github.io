---
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/posts.js';

const tags = getTags();
---

<Base title="标签" description="按标签浏览文章。">
  <h1 class="page-title">标签</h1>
  {
    tags.length === 0 ? (
      <p class="empty">还没有标签。在文章前言里写上 tags 就会出现在这里。</p>
    ) : (
      <ul class="name-list">
        {tags.map((tag) => (
          <li>
            <a href={`/tags/${tag.name}/`}>{tag.name}</a>
            <span> —— {tag.posts.length} 篇</span>
          </li>
        ))}
      </ul>
    )
  }
</Base>
