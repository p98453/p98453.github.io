---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import { getTag, getTags } from '../../lib/posts.js';

export function getStaticPaths() {
  return getTags().map((tag) => ({
    params: { tag: tag.name },
    props: { name: tag.name },
  }));
}

const tag = getTag(Astro.props.name);
---

<Base title={tag.name} description={`标签 ${tag.name} 下的文章。`}>
  <h1 class="page-title">{tag.name}</h1>
  <p class="subnav">
    <a href="/tags/">标签</a>
    <span> · {tag.posts.length} 篇</span>
  </p>
  <Listing posts={tag.posts} page={1} base={`/tags/${tag.name}/`} />
</Base>
