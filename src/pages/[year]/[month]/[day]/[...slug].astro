---
import Base from '../../../../layouts/Base.astro';
import Mermaid from '../../../../components/Mermaid.astro';
import { getPosts, getPost } from '../../../../lib/posts.js';
import { renderPost } from '../../../../lib/render.js';
import { categoryKey, site } from '../../../../lib/site.js';
import { writtenOn } from '../../../../lib/format.js';

export function getStaticPaths() {
  return getPosts().map((post) => ({
    params: {
      year: post.year,
      month: post.month,
      day: post.day,
      slug: post.slug,
    },
    props: { permalink: post.permalink },
  }));
}

const { permalink } = Astro.props;
const post = getPost(permalink);
const html = await renderPost(post);
const description = post.description || post.excerpt || site.description;

function separator(index, total) {
  if (index === 0) return '';
  if (index === total - 1) return ' 和 ';
  return '、';
}
---

<Base title={post.title} description={description} ogType="article">
  <article class="post">
    <h1>{post.title}</h1>
    <p class="pdate">
      <time datetime={post.dateText}>{writtenOn(post)}</time>
    </p>
    <div class="prose" set:html={html} />
    {post.hasMermaid && <Mermaid />}
    <div class="end-matter">
      {
        post.categories.length > 0 && (
          <p class="tags">
            分类：
            {post.categories.map((category, index) => (
              <>
                {separator(index, post.categories.length)}
                <a href={`/categories/${categoryKey(category)}/`}>{category}</a>
              </>
            ))}
          </p>
        )
      }
      {
        post.tags.length > 0 && (
          <p class="tags">
            本文标签：
            {post.tags.map((tag, index) => (
              <>
                {separator(index, post.tags.length)}
                <a href={`/tags/${tag}/`}>{tag}</a>
              </>
            ))}
          </p>
        )
      }
      <p class="source-link"><a href="source.md">查看 Markdown 原文</a></p>
    </div>
  </article>
</Base>
