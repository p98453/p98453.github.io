---
import { homeDate, SUMMARY_GAP } from '../lib/format.js';

const { posts } = Astro.props;
---

<div class="entries" id="entries">
  {
    posts.length === 0 ? (
      <p class="empty">没有文章。</p>
    ) : (
      posts.map((post) => (
        <article class="entry">
          <div class="date">
            <time datetime={post.dateText}>{homeDate(post)}</time>
          </div>
          <div class="detail">
            <h1>
              <a href={post.permalink}>{post.title}</a>
            </h1>
            {post.description ? <span class="summary">{SUMMARY_GAP}{post.description}</span> : null}
          </div>
        </article>
      ))
    )
  }
</div>
