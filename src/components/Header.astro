---
const path = Astro.url.pathname;
const items = [
  ['/blog/', '博客'],
  ['/archives/', '归档'],
  ['/categories/', '分类'],
  ['/tags/', '标签'],
];

function current(href) {
  if (href === '/blog/') return path === '/blog/' || path.startsWith('/blog/page/');
  return path === href || path.startsWith(href);
}
---

<div class="masthead">
  <div class="brand">
    <a href="/">
      <span class="seal" aria-hidden="true">林</span>
      <span class="name">小牛壮士</span>
    </a>的个人博客
  </div>
  <nav class="navigation" aria-label="主导航">
    {
      items.map(([href, label]) => (
        <a href={href} aria-current={current(href) ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</div>
